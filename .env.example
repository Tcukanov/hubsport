# Copy to .env.local for local development. On Vercel, set these under
# Project -> Settings -> Environment Variables. Everything is optional locally.

# --- Database -------------------------------------------------------------
# Postgres connection string. On Vercel, adding a Postgres database from the
# Storage tab (Neon) sets this for you. Without it the app uses ./data/store.json,
# which only works on your own machine.
DATABASE_URL=

# Secret used to sign session cookies and invitation links. Optional: when it
# is missing, one is derived from DATABASE_URL.
AUTH_SECRET=

# --- Email (pick one) -----------------------------------------------------
# Resend: https://resend.com -> API Keys. MAIL_FROM must be on a domain you
# verified there; with the test sender onboarding@resend.dev you can only
# email your own Resend account address.
RESEND_API_KEY=
MAIL_FROM=

# ...or any SMTP server. Gmail: smtp.gmail.com, port 465, your address, and an
# app password (Google Account -> Security -> App passwords).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# --- Shared inbox (optional) ----------------------------------------------
# The mailbox your provider receives on. Replies sent from the Inbox use it as
# Reply-To, so answers come back through the inbound webhook shown in Settings.
INBOUND_ADDRESS=
# Secret in the webhook address. Optional: derived from the auth secret.
INBOUND_SECRET=

# Public address of the app, used for links inside emails. Optional: detected
# from the request when missing.
APP_URL=

# --- Prospecting agent ----------------------------------------------------
# Claude API key (https://platform.claude.com). Without it the agent writes
# template drafts instead of AI drafts.
ANTHROPIC_API_KEY=
